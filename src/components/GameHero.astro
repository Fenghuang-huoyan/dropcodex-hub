---
import type { GameModule } from '../data/games';
import GameNav from './GameNav.astro';

interface Props {
  game: GameModule;
  active: 'overview' | 'calculator' | 'map' | 'database' | 'values';
  heading: string;
  subtitle?: string;
}
const { game, active, heading, subtitle } = Astro.props;
---
<section class="compact-game-bar">
  <img class="compact-game-bg" src={game.art.hero} alt="" width="1280" height="720" decoding="async" />
  <div class="compact-game-inner">
    <div class="compact-game-id">
      <img
        class="compact-capsule"
        src={game.art.header}
        alt={game.title}
        width="460"
        height="215"
        fetchpriority="high"
        decoding="async"
      />
      <div style="min-width:0;">
        <span class="compact-meta">{game.statusBadge} · {game.releaseLabel}</span>
        <h1>{heading}</h1>
        {subtitle && (
          <p style="margin:0.25rem 0 0; font-size:0.82rem; color:var(--text-dim); max-width:700px; line-height:1.45;">
            {subtitle}
          </p>
        )}
      </div>
    </div>
    <GameNav game={game} active={active} />
  </div>
</section>
