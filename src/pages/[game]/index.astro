---
import HubLayout from '../../layouts/HubLayout.astro';
import GameHero from '../../components/GameHero.astro';
import MonetizationBar from '../../components/MonetizationBar.astro';
import { gamesRegistry, type GameModule } from '../../data/games';
import { hubConfig } from '../../config/hub.config.mjs';

export function getStaticPaths() {
  return gamesRegistry.map((game) => ({
    params: { game: game.slug },
    props: { game },
  }));
}

interface Props {
  game: GameModule;
}
const { game } = Astro.props;
---
<HubLayout
  title={`${game.title} Tools, Crafting Calculator & Interactive Map — ${hubConfig.brandName}`}
  description={`Interactive crafting ratio calculator, completion map tracker, and item database for ${game.title} (${game.releaseLabel}).`}
  ogImage={game.art.header}
>
  <GameHero
    game={game}
    active="overview"
    heading={`${game.title} Tools & Database`}
    subtitle={game.summary}
  />

  <MonetizationBar game={game} />

  <div class="grid-cards">
    <div class="card">
      <span class="badge rarity-Legendary">Core Planner</span>
      <h3 style="margin:0.55rem 0 0.4rem;">Crafting &amp; Throughput Calculator</h3>
      <p style="font-size:0.88rem; color:var(--muted); margin:0 0 1rem;">
        Compute raw ore feedstock, multi-tier intermediate assemblies, machine counts, power draw (kW), and net value per minute.
      </p>
      <a class="btn" href={`/${game.slug}/calculator/`}>Launch Calculator →</a>
    </div>
    <div class="card">
      <span class="badge rarity-Rare">Progress Tracker</span>
      <h3 style="margin:0.55rem 0 0.4rem;">Interactive Map &amp; Save Check</h3>
      <p style="font-size:0.88rem; color:var(--muted); margin:0 0 1rem;">
        Filter {game.mapPins.length} key resource veins, extraction pods, and boss nodes with persistent browser completion tracking.
      </p>
      <a class="btn" href={`/${game.slug}/map/`}>Open Interactive Map →</a>
    </div>
    <div class="card">
      <span class="badge rarity-Uncommon">Reference Index</span>
      <h3 style="margin:0.55rem 0 0.4rem;">Filterable Item &amp; Recipe Database</h3>
      <p style="font-size:0.88rem; color:var(--muted); margin:0 0 1rem;">
        Search {game.items.length} indexed materials, modules, and equipment tiers by rarity, crafting time, and source facility.
      </p>
      <a class="btn btn-outline" href={`/${game.slug}/database/`}>Browse Item Database →</a>
    </div>
  </div>
</HubLayout>
