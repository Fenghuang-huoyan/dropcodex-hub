---
import HubLayout from '../../layouts/HubLayout.astro';
import GameHero from '../../components/GameHero.astro';
import MonetizationBar from '../../components/MonetizationBar.astro';
import { gamesRegistry, type GameModule } from '../../data/games';
import { hubConfig } from '../../config/hub.config.mjs';

export function getStaticPaths() {
  return gamesRegistry.map((game) => ({
    params: { game: game.slug },
    props: { game },
  }));
}

interface Props {
  game: GameModule;
}
const { game } = Astro.props;
---
<HubLayout
  title={`${game.title} Item Database, Recipes & Drop Sources — ${hubConfig.brandName}`}
  description={`Searchable item database, crafting recipes, power draw, and drop locations for ${game.title}.`}
  ogImage={game.art.header}
>
  <GameHero
    game={game}
    active="database"
    heading={`${game.title} Item & Recipe Database`}
    subtitle="Search and filter materials, intermediate components, and high-tier gear by rarity or source facility."
  />

  <MonetizationBar game={game} />

  {game.quickCodes && game.quickCodes.length > 0 && (
    <section class="card" style="margin-bottom:1.25rem;">
      <div style="display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:0.75rem; margin-bottom:0.85rem;">
        <div>
          <span class="badge rarity-Legendary" style="margin-bottom:0.25rem;">INSTANT CODE LOOKUP ({game.quickCodes.length})</span>
          <h2 style="margin:0; font-size:1.1rem;">Verified Safe Combinations, Door Keypads &amp; Controller Inputs</h2>
        </div>
        <input
          id="code-filter"
          class="input"
          type="search"
          placeholder="Filter location, gang, or digits (e.g. Kingpin, 0300, $250,000)..."
          aria-label="Filter safe codes and cheats"
          style="max-width:360px;"
        />
      </div>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>Location / Effect</th>
              <th>Type</th>
              <th>Code / D-Pad Combo</th>
              <th>Region / Unlock Requirement</th>
              <th>Field Note</th>
            </tr>
          </thead>
          <tbody id="code-tbody">
            {game.quickCodes.map((qc) => (
              <tr data-codehay={`${qc.target} ${qc.type} ${qc.codeOrCombo} ${qc.regionOrUnlock} ${qc.note}`.toLowerCase()}>
                <td><strong>{qc.target}</strong></td>
                <td><span class="badge rarity-Rare">{qc.type}</span></td>
                <td><code style="color:var(--emerald); font-weight:700; font-size:0.9rem;">{qc.codeOrCombo}</code></td>
                <td>{qc.regionOrUnlock}</td>
                <td style="color:var(--muted); font-size:0.82rem;">{qc.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <section class="card">
    <div style="margin-bottom:1rem; max-width:440px;">
      <input id="db-filter" class="input" type="search" placeholder="Search item name, rarity, or crafting station..." aria-label="Filter items" />
    </div>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>Item</th>
            <th>Category</th>
            <th>Rarity</th>
            <th>Base Value</th>
            <th>Cycle / Power</th>
            <th>Source / Station</th>
          </tr>
        </thead>
        <tbody id="db-tbody">
          {game.items.map((it) => {
            const code = it.name.split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase();
            const cycleLabel = it.craftTimeSec
              ? `${it.outputQty && it.outputQty > 1 ? `${it.outputQty}x / ` : ''}${it.craftTimeSec}s`
              : '—';
            const powerLabel = it.powerKw
              ? it.powerKw >= 1000
                ? ` · ${+(it.powerKw / 1000).toFixed(1)} MW`
                : ` · ${it.powerKw} kW`
              : '';
            return (
              <tr data-hay={`${it.name} ${it.category} ${it.rarity} ${it.biomeOrSource}`.toLowerCase()}>
                <td>
                  <span class="item-cell">
                    {it.iconUrl ? (
                      <img
                        src={it.iconUrl}
                        alt=""
                        width="26"
                        height="26"
                        loading="lazy"
                        style="width:26px;height:26px;object-fit:contain;border-radius:5px;border:1px solid var(--border);background:var(--surface-2);padding:2px;flex-shrink:0;"
                      />
                    ) : (
                      <span class={`item-glyph rarity-${it.rarity}`}>{code}</span>
                    )}
                    <strong>{it.name}</strong>
                  </span>
                </td>
                <td>{it.category}</td>
                <td><span class={`badge rarity-${it.rarity}`}>{it.rarity}</span></td>
                <td><strong>{it.baseValue}</strong></td>
                <td style="color:var(--muted); font-size:0.82rem;">
                  {cycleLabel}{powerLabel}
                </td>
                <td>{it.biomeOrSource}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  <script is:inline>
    const input = document.getElementById('db-filter');
    const rows = Array.from(document.querySelectorAll('#db-tbody tr'));
    if (input) {
      input.addEventListener('input', () => {
        const q = input.value.trim().toLowerCase();
        rows.forEach((r) => {
          r.style.display = !q || (r.getAttribute('data-hay') || '').includes(q) ? '' : 'none';
        });
      });
    }
    const codeInput = document.getElementById('code-filter');
    const codeRows = Array.from(document.querySelectorAll('#code-tbody tr'));
    if (codeInput) {
      codeInput.addEventListener('input', () => {
        const q = codeInput.value.trim().toLowerCase();
        codeRows.forEach((r) => {
          r.style.display = !q || (r.getAttribute('data-codehay') || '').includes(q) ? '' : 'none';
        });
      });
    }
  </script>
</HubLayout>
