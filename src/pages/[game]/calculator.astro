---
import HubLayout from '../../layouts/HubLayout.astro';
import GameHero from '../../components/GameHero.astro';
import MonetizationBar from '../../components/MonetizationBar.astro';
import { gamesRegistry, type GameModule } from '../../data/games';
import { hubConfig } from '../../config/hub.config.mjs';

export function getStaticPaths() {
  return gamesRegistry.map((game) => ({
    params: { game: game.slug },
    props: { game },
  }));
}

interface Props {
  game: GameModule;
}
const { game } = Astro.props;
const craftableItems = game.items.filter((i) => i.recipe && i.recipe.length > 0);
const serializedItems = JSON.stringify(game.items);
---
<HubLayout
  title={`${game.title} Crafting, Production Ratio & Profit Calculator — ${hubConfig.brandName}`}
  description={`Calculate exact raw resource requirements, smelter ratios, power load, and profit margin for ${game.title}.`}
  ogImage={game.art.header}
>
  <GameHero
    game={game}
    active="calculator"
    heading={`${game.title} Crafting & Ratio Calculator`}
    subtitle="Select any craftable target and desired output per minute to recursively break down raw materials, machine counts, kW power load, and net value added."
  />

  <MonetizationBar game={game} />

  <section class="card" aria-label="Production Ratio Calculator">
    <div class="grid-cards" style="margin-top:0; margin-bottom:1.1rem;">
      <label>
        <span style="display:block; font-size:0.82rem; font-weight:700; margin-bottom:0.35rem; color:#cbd5e1;">Target Output Item</span>
        <select id="calc-target-item" class="input">
          {(craftableItems.length > 0 ? craftableItems : game.items).map((it) => (
            <option value={it.id}>{it.name} ({it.rarity} · Base Value {it.baseValue})</option>
          ))}
        </select>
      </label>
      <label>
        <span style="display:block; font-size:0.82rem; font-weight:700; margin-bottom:0.35rem; color:#cbd5e1;">Target Units / Minute</span>
        <input id="calc-rate" class="input" type="number" min="1" max="10000" step="1" value="30" />
      </label>
    </div>

    <div class="stat-strip" style="margin-top:0; margin-bottom:1.4rem;">
      <div class="stat-pill">
        <span>Gross Output Value / Min</span>
        <strong id="out-gross" style="color:var(--emerald); font-size:1.25rem;">—</strong>
      </div>
      <div class="stat-pill">
        <span>Raw Feedstock Cost / Min</span>
        <strong id="out-cost" style="font-size:1.25rem;">—</strong>
      </div>
      <div class="stat-pill">
        <span>Net Value Margin / Min</span>
        <strong id="out-net" style="color:var(--accent-hover); font-size:1.25rem;">—</strong>
      </div>
      <div class="stat-pill">
        <span>Estimated Facility Load</span>
        <strong id="out-power" style="color:var(--sky); font-size:1.25rem;">—</strong>
      </div>
    </div>

    <h2 style="margin-top:0.5rem;">Recursive Bill of Materials &amp; Facility Count</h2>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>Material / Stage</th>
            <th>Rarity</th>
            <th>Required / Min</th>
            <th>Facilities Needed</th>
            <th>Source / Station</th>
          </tr>
        </thead>
        <tbody id="calc-bom-rows"></tbody>
      </table>
    </div>
  </section>

  <script is:inline define:vars={{ serializedItems }}>
    const items = JSON.parse(serializedItems);
    const itemMap = new Map(items.map((i) => [i.id, i]));
    const targetSel = document.getElementById('calc-target-item');
    const rateInput = document.getElementById('calc-rate');
    const bomBody = document.getElementById('calc-bom-rows');
    const grossEl = document.getElementById('out-gross');
    const costEl = document.getElementById('out-cost');
    const netEl = document.getElementById('out-net');
    const powerEl = document.getElementById('out-power');

    function compute() {
      const targetId = targetSel.value;
      const ratePerMin = Math.max(1, parseFloat(rateInput.value || '1') || 1);
      const rootItem = itemMap.get(targetId);
      if (!rootItem) return;

      const totals = new Map();
      let totalPowerKw = 0;
      let totalMachines = 0;
      let rawCost = 0;

      function walk(id, neededPerMin) {
        const node = itemMap.get(id);
        if (!node) return;
        totals.set(id, (totals.get(id) || 0) + neededPerMin);
        const craftSec = node.craftTimeSec || 4;
        const machines = neededPerMin / (60 / craftSec);
        totalMachines += machines;
        totalPowerKw += machines * (node.powerKw || 0);

        if (node.recipe && node.recipe.length > 0) {
          node.recipe.forEach((ing) => walk(ing.itemId, neededPerMin * ing.qty));
        } else {
          rawCost += neededPerMin * (node.baseValue || 0);
        }
      }

      walk(targetId, ratePerMin);
      const gross = ratePerMin * (rootItem.baseValue || 0);
      const net = gross - rawCost;

      grossEl.textContent = gross.toLocaleString('en-US') + ' pts';
      costEl.textContent = rawCost.toLocaleString('en-US') + ' pts';
      netEl.textContent = '+' + net.toLocaleString('en-US') + ' pts';
      powerEl.textContent = totalPowerKw > 0
        ? Math.ceil(totalPowerKw) + ' kW · ' + totalMachines.toFixed(1) + ' units'
        : totalMachines.toFixed(1) + ' stations';

      bomBody.innerHTML = '';
      totals.forEach((reqRate, id) => {
        const node = itemMap.get(id);
        const craftSec = node.craftTimeSec || 4;
        const machines = (reqRate / (60 / craftSec)).toFixed(1);
        const code = node.name.split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase();
        const tr = document.createElement('tr');
        tr.innerHTML =
          '<td><span class="item-cell"><span class="item-glyph rarity-' + node.rarity + '">' + code + '</span><strong>' + node.name + '</strong></span></td>' +
          '<td><span class="badge rarity-' + node.rarity + '">' + node.rarity + '</span></td>' +
          '<td><strong>' + reqRate.toFixed(1) + '</strong> / min</td>' +
          '<td>' + machines + 'x</td>' +
          '<td>' + node.biomeOrSource + '</td>';
        bomBody.appendChild(tr);
      });
    }

    targetSel.addEventListener('change', compute);
    rateInput.addEventListener('input', compute);
    compute();
  </script>
</HubLayout>
