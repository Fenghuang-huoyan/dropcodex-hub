---
import HubLayout from '../../layouts/HubLayout.astro';
import GameHero from '../../components/GameHero.astro';
import MonetizationBar from '../../components/MonetizationBar.astro';
import { gamesRegistry, type GameModule } from '../../data/games';
import { hubConfig } from '../../config/hub.config.mjs';

export function getStaticPaths() {
  return gamesRegistry.map((game) => ({
    params: { game: game.slug },
    props: { game },
  }));
}

interface Props {
  game: GameModule;
}
const { game } = Astro.props;
const craftableItems = [...game.items.filter((i) => i.recipe && i.recipe.length > 0)].reverse();
const serializedItems = JSON.stringify(game.items);
---
<HubLayout
  title={`${game.title} Crafting, Production Ratio & Profit Calculator — ${hubConfig.brandName}`}
  description={`Calculate exact raw resource requirements, smelter ratios, power load, and profit margin for ${game.title}.`}
  ogImage={game.art.header}
>
  <GameHero game={game} active="calculator" heading={`${game.title} — Production & Ratio Planner`} />

  <!-- Calculator Workbench Immediately Above the Fold -->
  <div class="panel">
    <div class="panel-head">
      <h2 class="panel-title">Target Production Parameters</h2>
      <div style="display:flex; gap:0.4rem;">
        <button class="btn btn-xs btn-outline rate-preset" type="button" data-rate="15">15/m</button>
        <button class="btn btn-xs btn-outline rate-preset" type="button" data-rate="30">30/m</button>
        <button class="btn btn-xs btn-outline rate-preset" type="button" data-rate="60">60/m</button>
        <button class="btn btn-xs btn-outline rate-preset" type="button" data-rate="120">120/m</button>
      </div>
    </div>

    <div class="panel-body">
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap:0.85rem; margin-bottom:1rem;">
        <label>
          <span style="display:block; font-size:0.76rem; font-weight:700; color:var(--text-dim); margin-bottom:0.3rem; text-transform:uppercase;">Target Output Module / Item</span>
          <select id="calc-target-item" class="input">
            {(craftableItems.length > 0 ? craftableItems : game.items).map((it) => (
              <option value={it.id}>{it.name} ({it.rarity} · Val {it.baseValue})</option>
            ))}
          </select>
        </label>
        <label>
          <span style="display:block; font-size:0.76rem; font-weight:700; color:var(--text-dim); margin-bottom:0.3rem; text-transform:uppercase;">Desired Output / Minute</span>
          <input id="calc-rate" class="input" type="number" inputmode="decimal" min="0.1" max="100000" step="1" value="30" />
          <span id="calc-clamp-hint" style="display:none; margin-top:0.25rem; font-size:0.72rem; color:#fbbf24;"></span>
        </label>
      </div>

      <div class="stat-strip">
        <div class="stat-pill">
          <span>Gross Output / Min</span>
          <strong id="out-gross" style="color:var(--emerald);">—</strong>
        </div>
        <div class="stat-pill">
          <span>Raw Ore Cost / Min</span>
          <strong id="out-cost">—</strong>
        </div>
        <div class="stat-pill">
          <span>Net Value Added / Min</span>
          <strong id="out-net" style="color:var(--accent-bright);">—</strong>
        </div>
        <div class="stat-pill">
          <span>Total Machines &amp; Power</span>
          <strong id="out-power" style="color:var(--sky);">—</strong>
        </div>
      </div>

      <!-- SCIM-Style Visual Production Chain Flow -->
      <div style="font-size:0.76rem; font-weight:700; color:var(--text-dim); text-transform:uppercase; margin-bottom:0.35rem;">
        Visual Production Chain Flow
      </div>
      <div id="calc-flow-chain" class="flow-chain" aria-live="polite"></div>

      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>Stage / Material</th>
              <th>Rarity</th>
              <th>Throughput / Min</th>
              <th>Facilities Required</th>
              <th>Facility / Source</th>
            </tr>
          </thead>
          <tbody id="calc-bom-rows"></tbody>
        </table>
      </div>
    </div>
  </div>

  <MonetizationBar game={game} />

  <script is:inline define:vars={{ serializedItems }}>
    const items = JSON.parse(serializedItems);
    const itemMap = new Map(items.map((i) => [i.id, i]));
    const targetSel = document.getElementById('calc-target-item');
    const rateInput = document.getElementById('calc-rate');
    const bomBody = document.getElementById('calc-bom-rows');
    const flowEl = document.getElementById('calc-flow-chain');
    const grossEl = document.getElementById('out-gross');
    const costEl = document.getElementById('out-cost');
    const netEl = document.getElementById('out-net');
    const powerEl = document.getElementById('out-power');
    const clampHintEl = document.getElementById('calc-clamp-hint');

    function esc(str) {
      return String(str ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    // Deep-link support (?item=fusion-regulator)
    const urlItem = new URLSearchParams(window.location.search).get('item');
    if (urlItem && itemMap.has(urlItem) && targetSel) {
      targetSel.value = urlItem;
    }

    function compute() {
      const targetId = targetSel.value;
      const rawInput = parseFloat(rateInput.value);
      const MIN_RATE = 0.1;
      const MAX_RATE = 100000;
      let ratePerMin = Number.isFinite(rawInput) ? rawInput : 1;
      if (clampHintEl) {
        if (!Number.isFinite(rawInput) || rawInput < MIN_RATE) {
          ratePerMin = MIN_RATE;
          clampHintEl.textContent = 'Minimum rate is 0.1 / min (calculating at 0.1/m).';
          clampHintEl.style.display = rateInput.value === '' ? 'none' : 'block';
        } else if (rawInput > MAX_RATE) {
          ratePerMin = MAX_RATE;
          clampHintEl.textContent = 'Capped at 100,000 / min to prevent numeric overflow.';
          clampHintEl.style.display = 'block';
        } else {
          clampHintEl.style.display = 'none';
        }
      }
      const rootItem = itemMap.get(targetId);
      if (!rootItem) return;

      const totals = new Map();
      const depths = new Map();
      let totalPowerKw = 0;
      let totalMachines = 0;
      let rawCost = 0;

      function renderGlyph(n) {
        if (n.iconUrl) {
          return '<img src="' + esc(n.iconUrl) + '" alt="" width="26" height="26" decoding="async" style="width:26px;height:26px;object-fit:contain;border-radius:5px;border:1px solid var(--border);background:var(--surface-2);padding:2px;flex-shrink:0;" />';
        }
        const code = esc(n.name.split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase());
        return '<span class="item-glyph rarity-' + esc(n.rarity) + '">' + code + '</span>';
      }

      function walk(id, neededPerMin, depth) {
        if (depth > 16) return;
        const node = itemMap.get(id);
        if (!node) return;
        totals.set(id, (totals.get(id) || 0) + neededPerMin);
        depths.set(id, Math.max(depths.get(id) || 0, depth));
        const craftSec = node.craftTimeSec || 4;
        const outQty = node.outputQty || 1;
        const batchesPerMin = neededPerMin / outQty;
        const machines = batchesPerMin / (60 / craftSec);
        totalMachines += machines;
        totalPowerKw += machines * (node.powerKw || 0);

        if (node.recipe && node.recipe.length > 0) {
          node.recipe.forEach((ing) => walk(ing.itemId, batchesPerMin * ing.qty, depth + 1));
        } else {
          rawCost += neededPerMin * (node.baseValue || 0);
        }
      }

      walk(targetId, ratePerMin, 0);
      const gross = Math.round(ratePerMin * (rootItem.baseValue || 0));
      const costRounded = Math.round(rawCost);
      const net = gross - costRounded;

      grossEl.textContent = gross.toLocaleString('en-US') + ' pts';
      costEl.textContent = costRounded.toLocaleString('en-US') + ' pts';
      netEl.textContent = (net >= 0 ? '+' : '') + net.toLocaleString('en-US') + ' pts';
      powerEl.textContent = totalPowerKw >= 1000
        ? (totalPowerKw / 1000).toFixed(1) + ' MW · ' + totalMachines.toFixed(1) + 'x'
        : totalPowerKw > 0
          ? Math.ceil(totalPowerKw) + ' kW · ' + totalMachines.toFixed(1) + 'x'
          : totalMachines.toFixed(1) + 'x stations';

      // Sort from raw inputs (highest depth) -> final output (depth 0) for visual flowchart
      const ordered = Array.from(totals.entries()).sort((a, b) => (depths.get(b[0]) || 0) - (depths.get(a[0]) || 0));

      flowEl.innerHTML = ordered
        .map(([id, req], idx) => {
          const n = itemMap.get(id);
          const machines = ((req / (n.outputQty || 1)) / (60 / (n.craftTimeSec || 4))).toFixed(1);
          const arrow = idx < ordered.length - 1 ? '<span class="flow-arrow">──▶</span>' : '';
          return (
            '<div class="flow-node">' +
            renderGlyph(n) +
            '<div><strong style="display:block;font-size:0.8rem">' + esc(n.name) + '</strong>' +
            '<span style="font-size:0.72rem;color:var(--text-dim)">' + req.toFixed(1) + '/m · ' + machines + 'x ' + esc(n.biomeOrSource) + '</span></div>' +
            '</div>' + arrow
          );
        })
        .join('');

      bomBody.innerHTML = '';
      Array.from(totals.entries()).forEach(([id, reqRate]) => {
        const node = itemMap.get(id);
        const machines = ((reqRate / (node.outputQty || 1)) / (60 / (node.craftTimeSec || 4))).toFixed(1);
        const tr = document.createElement('tr');
        tr.innerHTML =
          '<td><span class="item-cell">' + renderGlyph(node) + '<strong>' + esc(node.name) + '</strong></span></td>' +
          '<td><span class="badge rarity-' + esc(node.rarity) + '">' + esc(node.rarity) + '</span></td>' +
          '<td><strong>' + reqRate.toFixed(1) + '</strong> / min</td>' +
          '<td><strong>' + machines + 'x</strong></td>' +
          '<td style="color:var(--text-dim)">' + esc(node.biomeOrSource) + '</td>';
        bomBody.appendChild(tr);
      });
    }

    document.querySelectorAll('.rate-preset').forEach((btn) => {
      btn.addEventListener('click', () => {
        rateInput.value = btn.getAttribute('data-rate') || '30';
        compute();
      });
    });
    targetSel.addEventListener('change', compute);
    rateInput.addEventListener('input', compute);
    compute();
  </script>
</HubLayout>
