---
import HubLayout from '../../layouts/HubLayout.astro';
import GameHero from '../../components/GameHero.astro';
import MonetizationBar from '../../components/MonetizationBar.astro';
import { gamesRegistry, type GameModule } from '../../data/games';
import { hubConfig } from '../../config/hub.config.mjs';

export function getStaticPaths() {
  return gamesRegistry.map((game) => ({
    params: { game: game.slug },
    props: { game },
  }));
}

interface Props {
  game: GameModule;
}
const { game } = Astro.props;
const hasTrades = game.tradeValues.length > 0;
const isTradingGame = Boolean(game.hasPlayerTrading);
const pageTitle = game.seo?.valuesTitle ?? `${game.title} Economy & Tier Benchmark — ${hubConfig.brandName}`;
const pageDesc = game.seo?.valuesDesc ?? game.summary;
---
<HubLayout
  title={pageTitle}
  description={pageDesc}
  ogImage={game.art.header}
  noindex={!isTradingGame}
>
  <GameHero
    game={game}
    active="values"
    heading={`${game.title} — Economy & Benchmark Index`}
    subtitle={pageDesc}
  />

  <MonetizationBar game={game} />

  {hasTrades ? (
    <section class="card">
      <h2 style="margin-top:0;">{isTradingGame ? 'Market Value Reference' : 'Key Progression & Economy Benchmarks'}</h2>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>Benchmark Entry</th>
              <th>Reference Score / Output</th>
              {isTradingGame && <th>Demand</th>}
              <th>Tier</th>
              {isTradingGame && <th>Trend</th>}
            </tr>
          </thead>
          <tbody>
            {game.tradeValues.map((tv) => {
              const code = tv.name.split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase();
              return (
                <tr>
                  <td>
                    <span class="item-cell">
                      <span class={`item-glyph rarity-${tv.rarity}`}>{code}</span>
                      <strong>{tv.name}</strong>
                    </span>
                  </td>
                  <td><strong>{tv.score.toLocaleString('en-US')}</strong></td>
                  {isTradingGame && <td>{tv.demand}/10</td>}
                  <td><span class={`badge rarity-${tv.rarity}`}>{tv.rarity}</span></td>
                  {isTradingGame && <td>{tv.trend}</td>}
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>
  ) : (
    <section class="card">
      <p style="margin:0 0 0.85rem;">
        Open the interactive planner for <strong>{game.title}</strong> to compute exact costs and breakpoints:
      </p>
      <a class="btn" href={`/${game.slug}/calculator/`}>Launch {game.title} Planner →</a>
    </section>
  )}
</HubLayout>
