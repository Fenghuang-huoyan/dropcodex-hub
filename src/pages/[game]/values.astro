---
import HubLayout from '../../layouts/HubLayout.astro';
import GameHero from '../../components/GameHero.astro';
import MonetizationBar from '../../components/MonetizationBar.astro';
import { gamesRegistry, type GameModule } from '../../data/games';
import { hubConfig } from '../../config/hub.config.mjs';

export function getStaticPaths() {
  return gamesRegistry.map((game) => ({
    params: { game: game.slug },
    props: { game },
  }));
}

interface Props {
  game: GameModule;
}
const { game } = Astro.props;
const hasTrades = game.tradeValues.length > 0;
---
<HubLayout
  title={`${game.title} Value List & Economy Reference — ${hubConfig.brandName}`}
  description={`Item value index, demand ratings, and crafting profit margins for ${game.title}.`}
  ogImage={game.art.header}
>
  <GameHero
    game={game}
    active="values"
    heading={`${game.title} Economy & Value Index`}
    subtitle={
      hasTrades
        ? 'Compare high-tier item value scores, demand ratings, and market trends.'
        : `${game.title} focuses on solo/co-op factory & progression loops. Use the Ratio Calculator to maximize value output per minute.`
    }
  />

  <MonetizationBar game={game} />

  {hasTrades ? (
    <section class="card">
      <h2 style="margin-top:0;">High-Tier Value Reference</h2>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>Item</th>
              <th>Value Score</th>
              <th>Demand</th>
              <th>Rarity</th>
              <th>Trend</th>
            </tr>
          </thead>
          <tbody>
            {game.tradeValues.map((tv) => {
              const code = tv.name.split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase();
              return (
                <tr>
                  <td>
                    <span class="item-cell">
                      <span class={`item-glyph rarity-${tv.rarity}`}>{code}</span>
                      <strong>{tv.name}</strong>
                    </span>
                  </td>
                  <td><strong>{tv.score.toLocaleString('en-US')}</strong></td>
                  <td>{tv.demand}/10</td>
                  <td><span class={`badge rarity-${tv.rarity}`}>{tv.rarity}</span></td>
                  <td>{tv.trend}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>
  ) : (
    <section class="card">
      <p style="margin:0 0 0.85rem;">
        Want to find the highest-margin assembly line in <strong>{game.title}</strong>? Open the recursive throughput planner:
      </p>
      <a class="btn" href={`/${game.slug}/calculator/`}>Launch {game.title} Ratio Calculator →</a>
    </section>
  )}
</HubLayout>
