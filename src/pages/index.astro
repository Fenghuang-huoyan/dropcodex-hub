---
import HubLayout from '../layouts/HubLayout.astro';
import Icon from '../components/Icon.astro';
import { hubConfig } from '../config/hub.config.mjs';
import { gamesRegistry } from '../data/games';

const [leadGame, ...otherGames] = gamesRegistry;

const RARITY_RANK: Record<string, number> = {
  Legendary: 5,
  Epic: 4,
  Rare: 3,
  Uncommon: 2,
  Common: 1,
};

// Flatten all items across games with recursive raw-ore crafting margin & visual recipe input icons
const rawMatrixRows = gamesRegistry.flatMap((g, gIdx) => {
  const map = new Map(g.items.map((i) => [i.id, i]));
  function calcRawCost(item: typeof g.items[number], depth = 0): number {
    if (depth > 16 || !item.recipe || item.recipe.length === 0) return item.baseValue;
    const rawSum = item.recipe.reduce((sum, ing) => {
      const sub = map.get(ing.itemId);
      return sum + (sub ? calcRawCost(sub, depth + 1) : 0) * ing.qty;
    }, 0);
    return Math.round(rawSum / (item.outputQty || 1));
  }
  return g.items.map((it) => {
    const isCraftable = Boolean(it.recipe && it.recipe.length > 0);
    const margin = isCraftable ? it.baseValue - calcRawCost(it) : 0;
    const code = it.name.split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase();
    const recipeInputs = (it.recipe || []).slice(0, 3).map((ing) => {
      const sub = map.get(ing.itemId);
      const subName = sub ? sub.name : ing.itemId;
      return {
        qty: ing.qty,
        name: subName,
        iconUrl: sub?.iconUrl,
        code: subName.split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase(),
        rarity: sub?.rarity || 'Common',
      };
    });
    const extraCount = Math.max(0, (it.recipe?.length || 0) - 3);
    return {
      gameIdx: gIdx,
      gameSlug: g.slug,
      gameTitle: g.title,
      gameHeader: g.art.header,
      item: it,
      code,
      margin,
      isCraftable,
      recipeInputs,
      extraCount,
    };
  });
});

// Put high-tier craftable bottlenecks above raw ores so first-time visitors immediately see interactive recipes & icons
const matrixRows = [...rawMatrixRows].sort((a, b) => {
  if (a.isCraftable !== b.isCraftable) return a.isCraftable ? -1 : 1;
  const rDiff = (RARITY_RANK[b.item.rarity] || 0) - (RARITY_RANK[a.item.rarity] || 0);
  if (rDiff !== 0) return rDiff;
  return a.gameIdx - b.gameIdx;
});

const totalItems = matrixRows.length;
const totalPins = gamesRegistry.reduce((s, g) => s + g.mapPins.length, 0);
---
<HubLayout
  title={`${hubConfig.brandName} — Live Crafting Calculators, Tactical Maps & Item Database`}
  description={hubConfig.tagline}
>
  <!-- Compact Live Patch Status Bar (Maxroll Style) -->
  <div class="live-ticker">
    <div>
      <span class="ticker-pulse"></span>
      <strong>LIVE WORKBENCH:</strong>
      <span style="color:var(--text-dim); margin-left:0.35rem;">
        GTA VI Leonida Safe Codes &amp; Fences · Main Sequence EA Orbital Ratios · Below the Stone v1.0 Forge
      </span>
    </div>
    <div style="color:var(--text-dim); font-family:monospace; font-size:0.75rem;">
      {gamesRegistry.length} Hubs · {totalItems} Recipes/Items · {totalPins} Map Coords
    </div>
  </div>

  <!-- Asymmetric Bento Grid (1 Lead Spotlight + 2x2 Action Tiles — Zero Fluff Paragraphs) -->
  <section class="bento-grid" aria-label="Active Game Workbenches">
    <div class="bento-lead">
      <img
        class="bento-lead-img"
        src={leadGame.art.hero}
        alt={leadGame.title}
        width="1280"
        height="720"
        fetchpriority="high"
        decoding="async"
      />
      <div class="bento-lead-shade"></div>
      <div class="bento-lead-body">
        <span class="badge rarity-Legendary" style="margin-bottom:0.45rem;">{leadGame.statusBadge}</span>
        <h1 style="margin:0 0 0.25rem; font-size:1.75rem;">{leadGame.title} — Production &amp; Power Planner</h1>
        <p style="margin:0 0 0.85rem; color:var(--text-dim); font-size:0.86rem; max-width:560px;">
          Multi-stage smelter ratios, orbital assembler machine counts, kW load balancing &amp; sector resource coordinates.
        </p>
        <div style="display:flex; flex-wrap:wrap; gap:0.5rem;">
          <a class="btn" href={`/${leadGame.slug}/calculator/`}>
            <Icon name="calc" size={14} />
            <span>Open Ratio Calculator</span>
          </a>
          <a class="btn btn-outline" href={`/${leadGame.slug}/map/`}>
            <Icon name="map" size={14} />
            <span>Sector Map ({leadGame.mapPins.length})</span>
          </a>
          <a class="btn btn-outline" href={`/${leadGame.slug}/database/`}>
            <Icon name="db" size={14} />
            <span>Module DB ({leadGame.items.length})</span>
          </a>
        </div>
      </div>
    </div>

    <div class="bento-side">
      {otherGames.slice(0, 3).map((g) => (
        <div class="bento-tile">
          <img class="bento-tile-img" src={g.art.header} alt={g.title} width="460" height="215" loading="lazy" />
          <div class="bento-tile-shade"></div>
          <div class="bento-tile-content">
            <span class="badge rarity-Rare" style="margin-bottom:0.3rem;">{g.statusBadge}</span>
            <strong style="display:block; font-size:1.05rem; margin-bottom:0.45rem;">{g.title}</strong>
            <div style="display:flex; flex-wrap:wrap; gap:0.35rem;">
              <a class="btn btn-xs" href={`/${g.slug}/calculator/`}>Calculator</a>
              <a class="btn btn-xs btn-outline" href={`/${g.slug}/map/`}>Map</a>
              <a class="btn btn-xs btn-outline" href={`/${g.slug}/database/`}>DB</a>
            </div>
          </div>
        </div>
      ))}

      <a class="bento-tile" href="/main-sequence/calculator/?item=encoded-simulation-matrix" style="background:linear-gradient(145deg, #1a1628 0%, #0b101b 100%);">
        <div class="bento-tile-content">
          <span class="badge rarity-Epic" style="margin-bottom:0.35rem;">BOTTLENECK SOLVER</span>
          <strong style="display:block; font-size:0.98rem; margin-bottom:0.25rem;">Multi-Tier Recursive BOM Engine</strong>
          <span style="font-size:0.78rem; color:var(--text-dim);">
            Instant raw-ore-to-endgame matrix breakdown with exact facility counts &amp; MW draw.
          </span>
        </div>
      </a>
    </div>
  </section>

  <!-- SteamDB-Style High-Density Live Item & Crafting Matrix + Changelog Split -->
  <section class="data-split" aria-label="Live Crafting Matrix and Patch Updates">
    <div class="panel">
      <div class="panel-head">
        <h2 class="panel-title">
          <Icon name="db" size={16} />
          <span>Indexed Crafting &amp; Resource Matrix</span>
        </h2>
        <div style="display:flex; flex-wrap:wrap; gap:0.4rem; align-items:center;">
          <select id="matrix-game-filter" class="input" style="width:auto; padding:0.28rem 0.55rem; font-size:0.78rem;">
            <option value="ALL">All Games ({totalItems})</option>
            {gamesRegistry.map((g) => (
              <option value={g.slug}>{g.title}</option>
            ))}
          </select>
          <input
            id="matrix-text-filter"
            class="input"
            type="search"
            placeholder="Filter item, station, rarity..."
            style="width:190px; padding:0.28rem 0.6rem; font-size:0.78rem;"
          />
        </div>
      </div>

      <div class="table-scroll" style="max-height:560px; overflow-y:auto;">
        <table>
          <thead style="position:sticky; top:0; z-index:2; background:#0c1018;">
            <tr>
              <th>Game</th>
              <th>Item / Module</th>
              <th>Rarity</th>
              <th>Recipe Inputs</th>
              <th>Station</th>
              <th>Net Margin</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody id="matrix-tbody">
            {matrixRows.map((r) => (
              <tr
                data-game={r.gameSlug}
                data-hay={`${r.gameTitle} ${r.item.name} ${r.item.rarity} ${r.item.biomeOrSource}`.toLowerCase()}
              >
                <td>
                  <a href={`/${r.gameSlug}/`} title={r.gameTitle}>
                    <img class="game-thumb-xs" src={r.gameHeader} alt={r.gameTitle} width="136" height="64" loading="lazy" />
                  </a>
                </td>
                <td>
                  <span class="item-cell">
                    {r.item.iconUrl ? (
                      <img
                        src={r.item.iconUrl}
                        alt=""
                        width="26"
                        height="26"
                        loading="lazy"
                        style="width:26px;height:26px;object-fit:contain;border-radius:5px;border:1px solid var(--border);background:var(--surface-2);padding:2px;flex-shrink:0;"
                      />
                    ) : (
                      <span class={`item-glyph rarity-${r.item.rarity}`}>{r.code}</span>
                    )}
                    <strong>{r.item.name}</strong>
                  </span>
                </td>
                <td><span class={`badge rarity-${r.item.rarity}`}>{r.item.rarity}</span></td>
                <td>
                  {r.recipeInputs.length > 0 ? (
                    <span style="display:inline-flex; align-items:center; gap:0.3rem; flex-wrap:nowrap;">
                      {r.recipeInputs.map((ing) => (
                        <span
                          title={`${ing.qty}x ${ing.name}`}
                          style="display:inline-flex;align-items:center;gap:0.2rem;padding:0.1rem 0.32rem;border-radius:4px;background:var(--bg-rail);border:1px solid var(--border);font-size:0.72rem;color:var(--text-dim);white-space:nowrap;"
                        >
                          <strong style="color:var(--text);">{ing.qty}×</strong>
                          {ing.iconUrl ? (
                            <img src={ing.iconUrl} alt={ing.name} width="16" height="16" loading="lazy" style="width:16px;height:16px;object-fit:contain;flex-shrink:0;" />
                          ) : (
                            <span style="font-size:0.65rem;font-weight:800;">{ing.code}</span>
                          )}
                        </span>
                      ))}
                      {r.extraCount > 0 && (
                        <span style="font-size:0.7rem;color:var(--text-muted);">+{r.extraCount}</span>
                      )}
                    </span>
                  ) : (
                    <span style="color:var(--text-muted); font-size:0.76rem;">Raw Feedstock</span>
                  )}
                </td>
                <td style="color:var(--text-dim); font-size:0.8rem;">{r.item.biomeOrSource}</td>
                <td>
                  {r.margin > 0 ? (
                    <span style="color:var(--emerald); font-weight:700; white-space:nowrap;">+{r.margin.toLocaleString('en-US')} pts</span>
                  ) : (
                    <span style="color:var(--text-muted); font-size:0.76rem;">Val {r.item.baseValue}</span>
                  )}
                </td>
                <td>
                  {r.isCraftable ? (
                    <a class="btn btn-xs" href={`/${r.gameSlug}/calculator/?item=${r.item.id}`}>Calc →</a>
                  ) : (
                    <a class="btn btn-xs btn-outline" href={`/${r.gameSlug}/database/`}>Source</a>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Right Column: Live Patch & Tool Changelog + Map Quick-Jump -->
    <div style="display:flex; flex-direction:column; gap:1rem;">
      <div class="panel">
        <div class="panel-head">
          <h2 class="panel-title">
            <Icon name="bolt" size={15} />
            <span>Recent Patch &amp; DB Updates</span>
          </h2>
        </div>
        <ul class="changelog-list">
          <li>
            <div class="changelog-date">2026-11-25 · UE5 CLIENT EXTRACT</div>
            <strong style="display:block; margin:0.15rem 0;">Main Sequence Build #26097974 Full DB</strong>
            <span style="color:var(--text-dim);">Extracted all 74 client items, 63 exact recipes, Enriched 3x plate yields, native icons &amp; MW reactor loads.</span>
          </li>
          <li>
            <div class="changelog-date">2026-11-24 · CONSOLE LAUNCH</div>
            <strong style="display:block; margin:0.15rem 0;">GTA VI Leonida Safe Codes &amp; Fence DB</strong>
            <span style="color:var(--text-dim);">Indexed 19 verified fixed safe/door codes, Yasmani &amp; Moses laundering chains, and Ch.4 vault payouts.</span>
          </li>
          <li>
            <div class="changelog-date">2026-11-23 · v1.0.2 INDEX</div>
            <strong style="display:block; margin:0.15rem 0;">Below the Stone 1.0 Smelting Tree</strong>
            <span style="color:var(--text-dim);">Added Layer-3 extraction drill pod markers, bronze ingot ratios &amp; delver armor recipes.</span>
          </li>
          <li>
            <div class="changelog-date">2026-11-23 · v1.0 RELEASE</div>
            <strong style="display:block; margin:0.15rem 0;">Noble Fates Prestige Furniture</strong>
            <span style="color:var(--text-dim);">Indexed timber-to-plank carpentry ratios and banquet set value margins.</span>
          </li>
        </ul>
      </div>

      <div class="panel">
        <div class="panel-head">
          <h2 class="panel-title">
            <Icon name="map" size={15} />
            <span>Tactical Map Workbenches</span>
          </h2>
        </div>
        <ul class="changelog-list">
          {gamesRegistry.map((g) => (
            <li style="display:flex; align-items:center; justify-content:space-between; gap:0.5rem;">
              <div>
                <strong style="display:block;">{g.title}</strong>
                <span style="color:var(--text-dim); font-size:0.75rem;">{g.mapPins.length} interactive pins · Save sync</span>
              </div>
              <a class="btn btn-xs btn-outline" href={`/${g.slug}/map/`}>Open Map →</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <script is:inline>
    const gameSel = document.getElementById('matrix-game-filter');
    const textInp = document.getElementById('matrix-text-filter');
    const rows = Array.from(document.querySelectorAll('#matrix-tbody tr'));

    function filterMatrix() {
      const g = gameSel ? gameSel.value : 'ALL';
      const q = textInp ? textInp.value.trim().toLowerCase() : '';
      rows.forEach((tr) => {
        const matchGame = g === 'ALL' || tr.getAttribute('data-game') === g;
        const matchText = !q || (tr.getAttribute('data-hay') || '').includes(q);
        tr.style.display = matchGame && matchText ? '' : 'none';
      });
    }
    gameSel?.addEventListener('change', filterMatrix);
    textInp?.addEventListener('input', filterMatrix);
  </script>
</HubLayout>
